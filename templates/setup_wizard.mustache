{{!
    @template local_evalia/setup_wizard

    EVAL-IA setup wizard (setup.php), or its final screen once the setup is done.
    The steps are driven by amd/src/setup_wizard.js, which reads its strings from data-config.

    Context variables required for this template:
    * cfgtoken
    * cfgurl
    * coursesurl
    * curlok
    * dbtype
    * done
    * modecloud
    * modecustom
    * modelocal
    * moodleverok
    * moodleverstr
    * phpverok
    * phpverstr
    * saveurl
    * sesskey
    * settingsurl
    * wizardconfig

    Example context (json):
    {
        "done": false,
        "wizardconfig": "{}",
        "settingsurl": "https://example.edu/admin/settings.php?section=local_evalia",
        "coursesurl": "https://example.edu/course/index.php",
        "saveurl": "https://example.edu/local/evalia/setup.php?action=save",
        "sesskey": "abc123",
        "dbtype": "pgsql",
        "moodleverok": true,
        "phpverok": true,
        "curlok": true,
        "moodleverstr": "4.4.12",
        "phpverstr": "8.2.32",
        "cfgurl": "http://localhost:8052",
        "cfgtoken": "",
        "modelocal": true,
        "modecloud": false,
        "modecustom": false
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="evwiz mt-4" data-config="{{wizardconfig}}">

{{#done}}
  <div class="card shadow-sm">
    <div class="card-body done-card">
      <div class="done-icon">🎉</div>
      <h3>{{#str}}wizard_completion_title, local_evalia{{/str}}</h3>
      <p>{{#str}}wizard_completion_body, local_evalia{{/str}}</p>
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="{{settingsurl}}" class="btn btn-outline-secondary">
          {{#str}}wizard_done_admin_btn, local_evalia{{/str}}
        </a>
        <a href="{{coursesurl}}" class="btn btn-primary btn-lg px-5">
          {{#str}}wizard_done_courses_btn, local_evalia{{/str}}
        </a>
      </div>
    </div>
  </div>

{{/done}}
{{^done}}
  <!-- Progress bar -->
  <div class="evwiz-progress" id="evwiz-progress">
    <div class="step active" data-step="1">
      <div class="step-circle">1</div>
      <div class="step-label">{{#str}}wizard_step_welcome, local_evalia{{/str}}</div>
    </div>
    <div class="step" data-step="2">
      <div class="step-circle">2</div>
      <div class="step-label">{{#str}}wizard_step_requirements, local_evalia{{/str}}</div>
    </div>
    <div class="step" data-step="3">
      <div class="step-circle">3</div>
      <div class="step-label">{{#str}}wizard_step_ai_mode, local_evalia{{/str}}</div>
    </div>
    <div class="step" data-step="4">
      <div class="step-circle">4</div>
      <div class="step-label">{{#str}}wizard_step_connect, local_evalia{{/str}}</div>
    </div>
    <div class="step" data-step="5">
      <div class="step-circle">5</div>
      <div class="step-label">{{#str}}wizard_step_test, local_evalia{{/str}}</div>
    </div>
    <div class="step" data-step="6">
      <div class="step-circle">6</div>
      <div class="step-label">{{#str}}wizard_step_done, local_evalia{{/str}}</div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-4">

    <!-- ══════════════════════════════════════════
         STEP 1 — Welcome
         ══════════════════════════════════════════ -->
    <div class="evwiz-step active" id="evwiz-step-1">

      <div class="d-flex align-items-center gap-3 mb-3">
        <div>🧠</div>
        <div>
          <h3 class="mb-1">{{#str}}wizard_welcome_title, local_evalia{{/str}}</h3>
          <p class="text-muted mb-0">{{#str}}wizard_welcome_subtitle, local_evalia{{/str}}</p>
        </div>
      </div>
      <hr class="my-3">

      <p class="mb-3 evwiz-s2">
        {{#str}}wizard_welcome_intro, local_evalia{{/str}}
      </p>

      <div class="feature-grid mb-4">
        <div class="feature-item">
          <div class="fi-icon">📋</div>
          <div><h6>{{#str}}wizard_feat_rubric_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_rubric_desc, local_evalia{{/str}}</p></div>
        </div>
        <div class="feature-item">
          <div class="fi-icon">❓</div>
          <div><h6>{{#str}}wizard_feat_qbank_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_qbank_desc, local_evalia{{/str}}</p></div>
        </div>
        <div class="feature-item">
          <div class="fi-icon">📝</div>
          <div><h6>{{#str}}wizard_feat_unique_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_unique_desc, local_evalia{{/str}}</p></div>
        </div>
        <div class="feature-item">
          <div class="fi-icon">🤖</div>
          <div><h6>{{#str}}wizard_feat_grading_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_grading_desc, local_evalia{{/str}}</p></div>
        </div>
        <div class="feature-item">
          <div class="fi-icon">📊</div>
          <div><h6>{{#str}}wizard_feat_gradebook_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_gradebook_desc, local_evalia{{/str}}</p></div>
        </div>
        <div class="feature-item">
          <div class="fi-icon">💬</div>
          <div><h6>{{#str}}wizard_feat_telegram_title, local_evalia{{/str}}</h6>
            <p>{{#str}}wizard_feat_telegram_desc, local_evalia{{/str}}</p></div>
        </div>
      </div>

      <div class="d-flex justify-content-end">
        <button class="btn btn-primary px-5" data-evwiz-goto="2">{{#str}}wizard_btn_next, local_evalia{{/str}}</button>
      </div>
    </div><!-- /step 1 -->


    <!-- ══════════════════════════════════════════
         STEP 2 — Requirements (CRITICAL)
         ══════════════════════════════════════════ -->
    <div class="evwiz-step" id="evwiz-step-2">

      <h4 class="mb-1">{{#str}}wizard_req_title, local_evalia{{/str}}</h4>
      <p class="text-muted mb-4 evwiz-s3">
        {{#str}}wizard_req_intro, local_evalia{{/str}}
      </p>

      <!-- ─── Platform requirements ─── -->
      <div class="req-section">
        <div class="req-section-header evwiz-s4">
          {{#str}}wizard_req_platform_header, local_evalia{{/str}}
        </div>
        <div class="req-section-body">

          <div class="req-row">
            <div class="req-status">{{#moodleverok}}✅{{/moodleverok}}{{^moodleverok}}❌{{/moodleverok}}</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_moodle_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_moodle_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value">{{moodleverstr}}</div>
          </div>

          <div class="req-row">
            <div class="req-status">{{#phpverok}}✅{{/phpverok}}{{^phpverok}}❌{{/phpverok}}</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_php_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_php_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value">{{phpverstr}}</div>
          </div>

          <div class="req-row">
            <div class="req-status">{{#curlok}}✅{{/curlok}}{{^curlok}}❌{{/curlok}}</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_curl_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_curl_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value">{{#curlok}}{{#str}}wizard_req_curl_enabled, local_evalia{{/str}}{{/curlok}}{{^curlok}}<span class="text-danger">{{#str}}wizard_req_curl_missing, local_evalia{{/str}}</span>{{/curlok}}</div>
          </div>

          <div class="req-row">
            <div class="req-status">ℹ️</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_db_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_db_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value">{{dbtype}}</div>
          </div>

        </div>
      </div><!-- /platform -->

      <!-- ─── AI Engine requirement ─── -->
      <div class="req-section evwiz-s5">
        <div class="req-section-header evwiz-s6">
          {{#str}}wizard_req_engine_header, local_evalia{{/str}}
        </div>
        <div class="req-section-body">

          <p>
            {{#str}}wizard_req_engine_intro, local_evalia{{/str}}
          </p>

          <div class="req-row">
            <div class="req-status">🐍</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_engine_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_engine_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value evwiz-s8">
              <span class="badge bg-warning text-dark evwiz-s9">
                {{#str}}wizard_req_engine_badge, local_evalia{{/str}}
              </span>
            </div>
          </div>

          <div class="req-row">
            <div class="req-status">🗄️</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_chroma_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_chroma_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value">{{#str}}wizard_req_chroma_value, local_evalia{{/str}}</div>
          </div>

          <div class="req-row">
            <div class="req-status">🔤</div>
            <div class="req-label">
              <strong>{{#str}}wizard_req_llm_label, local_evalia{{/str}}</strong>
              <span>{{#str}}wizard_req_llm_desc, local_evalia{{/str}}</span>
            </div>
            <div class="req-value evwiz-s8">
              <span class="badge bg-danger evwiz-s9">
                {{#str}}wizard_req_llm_badge, local_evalia{{/str}}
              </span>
            </div>
          </div>

        </div>
      </div><!-- /engine -->

      <!-- ─── AI Provisioning options ─── -->
      <div class="req-section evwiz-s10">
        <div class="req-section-header evwiz-s11">
          {{#str}}wizard_prov_header, local_evalia{{/str}}
        </div>
        <div class="req-section-body">

          <p>
            {{#str}}wizard_prov_intro, local_evalia{{/str}}
          </p>

          <div class="ai-provision-cards">

            <div class="ai-pcard pc-local">
              <div class="pc-head">
                <div class="pc-icon">🖥️</div>
                <h6>{{#str}}wizard_prov_local_title, local_evalia{{/str}}
                    <span class="mode-badge badge-local">{{#str}}wizard_badge_selfhosted, local_evalia{{/str}}</span></h6>
              </div>
              <p>{{#str}}wizard_prov_local_desc, local_evalia{{/str}}</p>
              <ul>
                <li>{{#str}}wizard_prov_local_li1, local_evalia{{/str}}</li>
                <li>{{#str}}wizard_prov_local_li2, local_evalia{{/str}}</li>
                <li>{{#str}}wizard_prov_local_li3, local_evalia{{/str}}</li>
              </ul>
            </div>

            <div class="ai-pcard pc-cloud">
              <div class="pc-head">
                <div class="pc-icon">☁️</div>
                <h6>{{#str}}wizard_prov_cloud_title, local_evalia{{/str}}
                    <span class="mode-badge badge-cloud">{{#str}}wizard_badge_openai, local_evalia{{/str}}</span></h6>
              </div>
              <p>{{#str}}wizard_prov_cloud_desc, local_evalia{{/str}}</p>
              <ul>
                <li>{{#str}}wizard_prov_cloud_li1, local_evalia{{/str}}</li>
                <li>{{#str}}wizard_prov_cloud_li2, local_evalia{{/str}}</li>
                <li>{{#str}}wizard_prov_cloud_li3, local_evalia{{/str}}</li>
              </ul>
            </div>

            <div class="ai-pcard pc-custom">
              <div class="pc-head">
                <div class="pc-icon">⚙️</div>
                <h6>{{#str}}wizard_prov_custom_title, local_evalia{{/str}}
                    <span class="mode-badge badge-custom">{{#str}}wizard_badge_advanced, local_evalia{{/str}}</span></h6>
              </div>
              <p>{{#str}}wizard_prov_custom_desc, local_evalia{{/str}}</p>
              <ul>
                <li>{{#str}}wizard_prov_custom_li1, local_evalia{{/str}}</li>
                <li>{{#str}}wizard_prov_custom_li2, local_evalia{{/str}}</li>
              </ul>
            </div>

          </div><!-- /ai-provision-cards -->

          <div class="alert alert-danger mt-3 mb-0 py-2 px-3 evwiz-s13">
            {{#str}}wizard_prov_warning, local_evalia{{/str}}
          </div>

        </div>
      </div><!-- /ai provisioning -->

      <!-- Confirmation checkbox -->
      <div class="form-check mt-3 mb-1">
        <input class="form-check-input" type="checkbox" id="req-confirm">
        <label class="form-check-label evwiz-s3" for="req-confirm">
          {{#str}}wizard_req_confirm, local_evalia{{/str}}
        </label>
      </div>

      <div class="d-flex justify-content-between mt-3">
        <button class="btn btn-outline-secondary" data-evwiz-goto="1">
            {{#str}}wizard_btn_back, local_evalia{{/str}}
        </button>
        <button class="btn btn-primary px-5" id="req-next-btn" disabled
                data-evwiz-goto="3">{{#str}}wizard_btn_next, local_evalia{{/str}}</button>
      </div>
    </div><!-- /step 2 -->


    <!-- ══════════════════════════════════════════
         STEP 3 — AI Mode selection
         ══════════════════════════════════════════ -->
    <div class="evwiz-step" id="evwiz-step-3">

      <h4 class="mb-1">{{#str}}wizard_mode_title, local_evalia{{/str}}</h4>
      <p class="text-muted mb-4 evwiz-s3">
        {{#str}}wizard_mode_intro, local_evalia{{/str}}
      </p>

      <div class="mode-cards">

        <label class="mode-card {{#modelocal}}selected{{/modelocal}}" for="mode-local">
          <input type="radio" name="engine_mode" id="mode-local" value="local_ollama"
                 {{#modelocal}}checked{{/modelocal}}>
          <div class="mc-icon">🖥️</div>
          <h5>{{#str}}wizard_mode_local_title, local_evalia{{/str}}
              <span class="mode-badge badge-local">{{#str}}wizard_badge_selfhosted, local_evalia{{/str}}</span></h5>
          <p>{{#str}}wizard_mode_local_desc, local_evalia{{/str}}</p>
        </label>

        <label class="mode-card {{#modecloud}}selected{{/modecloud}}" for="mode-cloud">
          <input type="radio" name="engine_mode" id="mode-cloud" value="cloud_api"
                 {{#modecloud}}checked{{/modecloud}}>
          <div class="mc-icon">☁️</div>
          <h5>{{#str}}wizard_mode_cloud_title, local_evalia{{/str}}
              <span class="mode-badge badge-cloud">{{#str}}wizard_badge_openai, local_evalia{{/str}}</span></h5>
          <p>{{#str}}wizard_mode_cloud_desc, local_evalia{{/str}}</p>
        </label>

        <label class="mode-card {{#modecustom}}selected{{/modecustom}}" for="mode-custom">
          <input type="radio" name="engine_mode" id="mode-custom" value="custom"
                 {{#modecustom}}checked{{/modecustom}}>
          <div class="mc-icon">⚙️</div>
          <h5>{{#str}}wizard_mode_custom_title, local_evalia{{/str}}
              <span class="mode-badge badge-custom">{{#str}}wizard_badge_advanced, local_evalia{{/str}}</span></h5>
          <p>{{#str}}wizard_mode_custom_desc, local_evalia{{/str}}</p>
        </label>

      </div>

      <div class="d-flex justify-content-between mt-4">
        <button class="btn btn-outline-secondary" data-evwiz-goto="2">
            {{#str}}wizard_btn_back, local_evalia{{/str}}
        </button>
        <button class="btn btn-primary px-5" data-evwiz-goto="4">{{#str}}wizard_btn_next, local_evalia{{/str}}</button>
      </div>
    </div><!-- /step 3 -->


    <!-- ══════════════════════════════════════════
         STEP 4 — Connection details
         ══════════════════════════════════════════ -->
    <div class="evwiz-step" id="evwiz-step-4">

      <h4 class="mb-1">{{#str}}wizard_step4_title, local_evalia{{/str}}</h4>
      <p class="text-muted mb-4 evwiz-s3">
        {{#str}}wizard_step4_intro, local_evalia{{/str}}
      </p>

      <!-- Mode-specific hints (shown/hidden by JS) -->
      <div id="hint-local_ollama" class="alert alert-light border mb-3 py-2 px-3 evwiz-s14">
        <strong>{{#str}}wizard_hint_local_title, local_evalia{{/str}}</strong>
        {{#str}}wizard_hint_local_body, local_evalia{{/str}}
      </div>
      <div id="hint-cloud_api" class="alert alert-light border mb-3 py-2 px-3 evwiz-s14" style="display: none;">
        <strong>{{#str}}wizard_hint_cloud_title, local_evalia{{/str}}</strong>
        {{#str}}wizard_hint_cloud_body, local_evalia{{/str}}
      </div>
      <div id="hint-custom" class="alert alert-light border mb-3 py-2 px-3 evwiz-s14" style="display: none;">
        <strong>{{#str}}wizard_hint_custom_title, local_evalia{{/str}}</strong>
        {{#str}}wizard_hint_custom_body, local_evalia{{/str}}
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold" for="evwiz-url">
          {{#str}}wizard_url_label, local_evalia{{/str}} <span class="text-danger">*</span>
        </label>
        <input type="url" class="form-control" id="evwiz-url"
               placeholder="http://localhost:8052"
               value="{{cfgurl}}">
        <div class="form-text">{{#str}}wizard_url_help, local_evalia{{/str}}</div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold" for="evwiz-token">{{#str}}wizard_token_label, local_evalia{{/str}}</label>
        <input type="password" class="form-control" id="evwiz-token"
               placeholder="{{#cleanstr}}wizard_token_placeholder, local_evalia{{/cleanstr}}"
               value="{{cfgtoken}}">
        <div class="form-text">
          {{#str}}wizard_token_help, local_evalia{{/str}}
        </div>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <button class="btn btn-outline-secondary" data-evwiz-goto="3">
            {{#str}}wizard_btn_back, local_evalia{{/str}}
        </button>
        <button class="btn btn-primary px-5" data-evwiz-goto="5">{{#str}}wizard_btn_test, local_evalia{{/str}}</button>
      </div>
    </div><!-- /step 4 -->


    <!-- ══════════════════════════════════════════
         STEP 5 — Health check
         ══════════════════════════════════════════ -->
    <div class="evwiz-step" id="evwiz-step-5">

      <h4 class="mb-1">{{#str}}wizard_step5_title, local_evalia{{/str}}</h4>
      <p class="text-muted mb-4 evwiz-s3">
        {{#str}}wizard_step5_intro, local_evalia{{/str}}
      </p>

      <div id="evwiz-health-result" class="mb-3">
        <div class="d-flex align-items-center gap-2 text-muted py-2">
          <div class="spinner-border spinner-border-sm" role="status"></div>
          <span>{{#str}}wizard_connecting, local_evalia{{/str}}</span>
        </div>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <button class="btn btn-outline-secondary" data-evwiz-goto="4">
            {{#str}}wizard_btn_back, local_evalia{{/str}}
        </button>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-secondary" id="evwiz-retry-btn" style="display: none;"
                  data-evwiz-action="runtest">{{#str}}wizard_btn_retry, local_evalia{{/str}}</button>
          <button class="btn btn-success px-5" id="evwiz-save-btn" style="display: none;"
                  data-evwiz-action="save">{{#str}}wizard_btn_save_finish, local_evalia{{/str}}</button>
        </div>
      </div>
    </div><!-- /step 5 -->


    <!-- ══════════════════════════════════════════
         STEP 6 — Done (inline, before POST redirect)
         ══════════════════════════════════════════ -->
    <div class="evwiz-step" id="evwiz-step-6">
      <div class="done-card">
        <div class="done-icon">✅</div>
        <h3>{{#str}}wizard_done_title, local_evalia{{/str}}</h3>
        <p>{{#str}}wizard_done_body, local_evalia{{/str}}</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
          <a href="{{settingsurl}}" class="btn btn-outline-secondary">
            {{#str}}wizard_done_admin_btn, local_evalia{{/str}}
          </a>
          <a href="{{coursesurl}}" class="btn btn-primary btn-lg px-5">
            {{#str}}wizard_done_courses_btn, local_evalia{{/str}}
          </a>
        </div>
      </div>
    </div><!-- /step 6 -->

    </div><!-- /card-body -->
  </div><!-- /card -->

  <!-- Hidden save form -->
  <form id="evwiz-save-form" method="post"
        action="{{saveurl}}"
        style="display: none;">
    <input type="hidden" name="sesskey"      value="{{sesskey}}">
    <input type="hidden" name="engine_mode"  id="sf-mode"  value="">
    <input type="hidden" name="engine_url"   id="sf-url"   value="">
    <input type="hidden" name="engine_token" id="sf-token" value="">
  </form>

{{/done}}
</div><!-- /evwiz -->
