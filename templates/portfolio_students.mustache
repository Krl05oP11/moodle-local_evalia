{{!
    @template local_evalia/portfolio_students

    Students of the course with their portfolio summary; a row opens the detail panel.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * students - list of {userid, fullname, active, hasportfolio, totalexams, avggrade}

    Example context (json):
    {
        "students": [
            {
                "userid": 5,
                "fullname": "Ana García",
                "active": false,
                "hasportfolio": true,
                "totalexams": 2,
                "avggrade": "7.5"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>{{#str}}table_student, local_evalia{{/str}}</th>
                <th class="text-center">{{#str}}tab_exams, local_evalia{{/str}}</th>
                <th class="text-center">{{#str}}portfolio_avg_grade, local_evalia{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#students}}
            <tr class="evalia-portfolio-row evalia-clickable{{#active}} table-active{{/active}}" data-userid="{{userid}}"
                data-fullname="{{fullname}}" tabindex="0">
                <td><small>{{fullname}}</small></td>
                <td class="text-center"><small>{{#hasportfolio}}{{totalexams}}{{/hasportfolio}}{{^hasportfolio}}<span class="text-muted">0</span>{{/hasportfolio}}</small></td>
                <td class="text-center"><small>{{#hasportfolio}}<span class="fw-bold">{{avggrade}}</span>{{/hasportfolio}}{{^hasportfolio}}<span class="text-muted">—</span>{{/hasportfolio}}</small></td>
            </tr>
            {{/students}}
        </tbody>
    </table>
</div>
