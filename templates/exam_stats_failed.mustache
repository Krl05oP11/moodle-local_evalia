{{!
    @template local_evalia/exam_stats_failed

    Most failed questions of an exam.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * questions - list of {num, topic, difficulty, difficultyclass, pct, stem}
    * empty - true when there is no data

    Example context (json):
    {
        "empty": false,
        "questions": [
            {
                "num": 1,
                "topic": "Photosynthesis",
                "difficulty": "Medium",
                "difficultyclass": "evalia-diff-medium",
                "pct": 75,
                "stem": "Which pigment absorbs light?"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#empty}}<p class="text-muted small">{{#str}}stats_no_data, local_evalia{{/str}}</p>{{/empty}}
{{#questions}}
<div class="mb-2 border rounded p-2">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <span class="text-muted small fw-bold me-2">#{{num}}</span>
        <div class="flex-grow-1">
            {{#topic}}<span class="badge me-1 evalia-topic-badge" title="{{#str}}stat_topic_title, local_evalia{{/str}}">{{topic}}</span>{{/topic}}
            {{#difficulty}}<span class="badge {{difficultyclass}}">{{difficulty}}</span>{{/difficulty}}
        </div>
        <span class="small text-danger fw-bold ms-2">{{#str}}stat_pct_failed, local_evalia, {{pct}}{{/str}}</span>
    </div>
    <div class="small text-dark mb-1">{{stem}}</div>
    <div class="progress evalia-progress-thin">
        <div class="progress-bar bg-danger" role="progressbar" style="width: {{pct}}%;" aria-valuenow="{{pct}}"
            aria-valuemin="0" aria-valuemax="100"></div>
    </div>
</div>
{{/questions}}
