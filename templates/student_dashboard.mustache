{{!
    @template local_evalia/student_dashboard

    The student's exams in a course (student.php): one card per exam with its status and next step.

    Context variables required for this template:
    * coursename - course name, output of format_string()
    * hasexams - true when the student has exams in the course
    * exams - list of {name, statusclass, statuslabel, bordercls, timelimit, from, until, submitted, graded,
      published, score, windownote, showbtn, btnlabel, btncls, detailurl}

    Example context (json):
    {
        "coursename": "Discrete Mathematics",
        "hasexams": true,
        "exams": [
            {
                "name": "Midterm", "statusclass": "bg-success", "statuslabel": "Published", "bordercls": "border-success",
                "timelimit": "60 min", "from": "", "until": "", "submitted": "", "graded": false, "published": true,
                "score": "8.5", "windownote": "", "showbtn": false, "btnlabel": "", "btncls": "",
                "detailurl": "https://example.edu/local/evalia/student_exam.php?student_examid=4"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="container-fluid mt-4 evalia-student">

    <div class="d-flex align-items-baseline gap-3 mb-4">
        <h2 class="mb-0">{{#str}}student:heading, local_evalia{{/str}}</h2>
        <span class="text-muted">{{{coursename}}}</span>
    </div>

    {{^hasexams}}
    <div class="alert alert-info d-flex align-items-center gap-3">
        <span class="evalia-student-icon" aria-hidden="true">📭</span>
        <div>
            <strong>{{#str}}student:none_assigned, local_evalia{{/str}}</strong><br>
            <small>{{#str}}student:none_assigned_desc, local_evalia{{/str}}</small>
        </div>
    </div>
    {{/hasexams}}

    {{#exams}}
    <div class="card {{bordercls}} mb-3 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span class="fw-bold">{{name}}</span>
            <span class="badge {{statusclass}}">{{statuslabel}}</span>
        </div>
        <div class="card-body py-3">
            <div class="d-flex flex-wrap gap-3 mb-2 text-muted small">
                {{#timelimit}}<span>{{timelimit}}</span>{{/timelimit}}
                {{#from}}<span>{{from}}</span>{{/from}}
                {{#until}}<span>{{until}}</span>{{/until}}
            </div>

            {{#submitted}}<p class="text-muted small mb-0">{{submitted}}</p>{{/submitted}}
            {{#graded}}<p class="text-muted small mb-0">{{#str}}student:msg_graded, local_evalia{{/str}}</p>{{/graded}}
            {{#published}}
            <div class="d-flex align-items-center gap-3 mt-1">
                <span class="fs-3 fw-bold text-success">{{score}} / 10.0</span>
                <a href="{{detailurl}}" class="btn btn-sm btn-outline-success">{{#str}}student:btn_detail, local_evalia{{/str}}</a>
            </div>
            {{/published}}
            {{#windownote}}<p class="text-danger small mb-0">{{windownote}}</p>{{/windownote}}

            {{#showbtn}}
            <div class="mt-3">
                <a href="{{detailurl}}" class="btn {{btncls}} px-4">{{btnlabel}}</a>
            </div>
            {{/showbtn}}
        </div>
    </div>
    {{/exams}}

</div>
