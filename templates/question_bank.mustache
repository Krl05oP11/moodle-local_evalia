{{!
    @template local_evalia/question_bank

    Question bank table with approve and reject buttons.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * questions - list of {id, topic, stem, typelabel, difficultyclass, difficultylabel, statusclass, statuslabel}

    Example context (json):
    {
        "questions": [
            {
                "id": 3,
                "topic": "Photosynthesis",
                "stem": "Which pigment absorbs light?",
                "typelabel": "MC",
                "difficultyclass": "bg-info text-dark",
                "difficultylabel": "Basic",
                "statusclass": "bg-secondary",
                "statuslabel": "Pending review"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>{{#str}}rubric_item_topic, local_evalia{{/str}}</th>
                <th>{{#str}}table_question, local_evalia{{/str}}</th>
                <th>{{#str}}table_type, local_evalia{{/str}}</th>
                <th>{{#str}}gen_questions_difficulty_label, local_evalia{{/str}}</th>
                <th>{{#str}}table_status, local_evalia{{/str}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#questions}}
            <tr>
                <td><small class="text-muted">{{topic}}</small></td>
                <td><small>{{stem}}</small></td>
                <td><span class="badge bg-light text-dark border">{{typelabel}}</span></td>
                <td><span class="badge {{difficultyclass}}">{{difficultylabel}}</span></td>
                <td><span class="badge {{statusclass}}">{{statuslabel}}</span></td>
                <td class="text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-success py-0 me-1 evalia-approve-btn" data-id="{{id}}"
                        title="{{#str}}questions_approve, local_evalia{{/str}}"
                        aria-label="{{#str}}questions_approve, local_evalia{{/str}}">✓</button>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 evalia-reject-btn" data-id="{{id}}"
                        title="{{#str}}questions_reject, local_evalia{{/str}}"
                        aria-label="{{#str}}questions_reject, local_evalia{{/str}}">✗</button>
                </td>
            </tr>
            {{/questions}}
        </tbody>
    </table>
</div>
