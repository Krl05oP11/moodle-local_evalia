{{!
    @template local_evalia/exam_stats_summary

    Summary cards of the exam statistics.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * cards - list of {icon, label, value, color}

    Example context (json):
    {
        "cards": [
            {
                "icon": "👥",
                "label": "Total",
                "value": 12,
                "color": "secondary"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#cards}}
<div class="col">
    <div class="card text-center border-{{color}}">
        <div class="card-body py-2 px-1">
            <div class="fs-5" aria-hidden="true">{{icon}}</div>
            <div class="fw-bold text-{{color}}">{{value}}</div>
            <div class="text-muted small">{{label}}</div>
        </div>
    </div>
</div>
{{/cards}}
