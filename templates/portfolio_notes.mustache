{{!
    @template local_evalia/portfolio_notes

    Teacher observations on a student portfolio.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * notes - list of {author, date, text}

    Example context (json):
    {
        "notes": [
            {
                "author": "Carlos Ponce",
                "date": "10/11/2026 18:30",
                "text": "Good progress in unit 2."
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#notes}}
<div class="border rounded p-2 mb-2 bg-light">
    <small class="text-muted d-block mb-1">{{author}} · {{date}}</small>
    <span class="small evalia-note-text">{{text}}</span>
</div>
{{/notes}}
