{{!
    @template local_evalia/exam_stats_bands

    Distribution of the exam scores in bands, as horizontal bars.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * bands - list of {label, count, pct, color}
    * empty - true when there is no data

    Example context (json):
    {
        "empty": false,
        "bands": [
            {
                "label": "0-4",
                "count": 3,
                "pct": 60,
                "color": "danger"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#empty}}<p class="text-muted small">{{#str}}stats_no_data, local_evalia{{/str}}</p>{{/empty}}
{{#bands}}
<div class="d-flex align-items-center gap-2 mb-1">
    <span class="text-muted small evalia-band-label">{{label}}</span>
    <div class="flex-grow-1 bg-light rounded evalia-band-track">
        <div class="bg-{{color}} rounded h-100" style="width: {{pct}}%;"></div>
    </div>
    <span class="small fw-bold evalia-band-count">{{count}}</span>
</div>
{{/bands}}
