<style>
.evalia-fab {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    border: none;
    box-shadow: 0 4px 18px rgba(99,102,241,.45);
    cursor: pointer;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10400;
    transition: transform .15s, box-shadow .15s;
    user-select: none;
}
.evalia-fab:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(99,102,241,.55); }
.evalia-fab--dragging { opacity: .85; }

.evalia-chat-panel {
    position: fixed;
    bottom: 92px;
    right: 28px;
    width: 360px;
    max-width: 94vw;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 8px 36px rgba(0,0,0,.18);
    border: 1px solid #e0e7ff;
    z-index: 10400;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.evalia-chat-header {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: .88rem;
}
.evalia-chat-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 2px;
}
.evalia-chat-messages {
    height: 300px;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #f8faff;
}
.evalia-msg {
    max-width: 85%;
    padding: 7px 11px;
    border-radius: 10px;
    font-size: .83rem;
    line-height: 1.45;
    word-break: break-word;
}
.evalia-msg--user {
    background: #6366f1;
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 3px;
}
.evalia-msg--assistant {
    background: #e0e7ff;
    color: #1e1b4b;
    align-self: flex-start;
    border-bottom-left-radius: 3px;
}
.evalia-msg--typing { opacity: .6; font-style: italic; }
.evalia-chat-input-row {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-top: 1px solid #e0e7ff;
    background: #fff;
}
.evalia-chat-input-row input {
    flex: 1;
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: .83rem;
    outline: none;
}
.evalia-chat-input-row input:focus { border-color: #6366f1; }
.evalia-chat-input-row button {
    background: #6366f1;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: .9rem;
}
.evalia-chat-input-row button:disabled { opacity: .6; cursor: not-allowed; }
</style>

<button id="evalia-fab" class="evalia-fab" title="{{fab_title}}" aria-label="{{fab_aria_label}}">
