{{!
    Template: evalia_teacher — EVAL-IA Teacher Panel (4 tabs)
    @package    local_evalia
    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div id="evalia-teacher-panel" data-courseid="{{courseid}}" data-sesskey="{{sesskey}}">

    {{! ── Toolbar ─────────────────────────────────────────────────────── }}
    <div class="d-flex justify-content-end mb-2">
        <button id="evalia-btn-workflow" class="btn btn-sm btn-outline-secondary"
                style="border-color:#a5b4fc; color:#6366f1; font-size:.82rem;">
            🗺️ {{btn_workflow}}
        </button>
    </div>

    {{! ── Tab navigation ─────────────────────────────────────────────── }}
    <ul class="nav nav-tabs mb-4" id="evaliaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-rubric-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-rubric"
                    type="button" role="tab" aria-selected="true">
                📋 {{tab_rubric}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-questions-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-questions"
                    type="button" role="tab" aria-selected="false">
                ❓ {{tab_questions}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-exams-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-exams"
                    type="button" role="tab" aria-selected="false">
                📝 {{tab_exams}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-portfolio-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-portfolio"
                    type="button" role="tab" aria-selected="false">
                📁 {{tab_portfolio}}
            </button>
        </li>
    </ul>

    {{! ── Tab content ─────────────────────────────────────────────────── }}
    <div class="tab-content" id="evaliaTabContent">

        {{! ── Tab 1: Rúbrica ────────────────────────────────────────── }}
        <div class="tab-pane fade show active" id="tab-rubric" role="tabpanel">

            {{! ── Material del curso ── }}
            <div class="card mb-3" style="border:1px solid #0891b2;">
                <div class="card-header d-flex justify-content-between align-items-center"
                     style="background:#0891b2;">
                    <div>
                        <strong style="color:#fff;">📚 {{material_title}}</strong>
                        <small style="color:#e0f7fa;" class="ms-2">{{material_subtitle}}</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span id="evalia-index-status" class="small" style="color:#e0f7fa;"></span>
                        <button id="evalia-btn-index-course" class="btn btn-sm"
                                style="background:#fff;color:#0891b2;border:none;font-weight:600;">
                            🔍 {{btn_index_material}}
                        </button>
                    </div>
                </div>
                <div class="card-body py-2 px-3" style="background:#f0fdff;">
                    <p class="mb-1 small text-dark">
                        <strong>{{material_how_title}}</strong>
                        {{material_how_desc}}
                    </p>
                    <ol class="mb-1 small text-dark ps-3">
                        <li>{{{material_step1}}}</li>
                        <li>{{{material_step2}}}</li>
                        <li>{{material_step3}}</li>
                    </ol>
                    <div id="evalia-index-loading" style="display:none;" class="mt-1">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                            <span class="text-info small">{{material_indexing}}</span>
                        </div>
                    </div>
                </div>
            </div>

            {{! ── Selector de fuentes (acordeón lazy) ── }}
            <div class="card mb-3 border-secondary-subtle">
                <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center"
                     id="evalia-sources-toggle" role="button" style="cursor:pointer;">
                    <span>
                        📖 <strong>{{sources_title}}</strong>
                        <small class="text-muted ms-1">{{sources_subtitle}}</small>
                    </span>
                    <span>
                        <span id="evalia-sources-badge" class="badge bg-secondary me-2" style="display:none;"></span>
                        <span id="evalia-sources-arrow">▶</span>
                    </span>
                </div>
                <div id="evalia-sources-panel" class="card-body py-2 px-3" style="display:none;">
                    <div id="evalia-sources-list" class="mb-2">
                        <span class="text-muted small">{{sources_loading}}</span>
                    </div>
                    <div class="mt-1">
                        <a href="#" id="evalia-sources-select-all" class="small">{{sources_select_all}}</a>
                        <span class="text-muted mx-2">·</span>
                        <a href="#" id="evalia-sources-select-none" class="small">{{sources_select_none}}</a>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">{{tab_rubric}}</h5>
                    <div class="d-flex align-items-center gap-2">
                        <input type="text"
                               id="evalia-rubric-scope"
                               class="form-control form-control-sm"
                               style="width:180px;"
                               placeholder="{{rubric_scope_placeholder}}">
                        <input type="number"
                               id="evalia-rubric-item-count"
                               class="form-control form-control-sm"
                               style="width:80px;"
                               min="5" max="40" value="{{rubric_default_items}}"
                               title="{{rubric_item_count_title}}">
                        <button id="evalia-btn-generate-rubric" class="btn btn-primary">
                            ✨ {{rubric_generate}}
                        </button>
                        <button id="evalia-btn-save-rubric" class="btn btn-success ms-2" style="display:none;">
                            💾 {{rubric_save}}
                        </button>
                        <button id="evalia-btn-activate-rubric" class="btn btn-warning ms-2" style="display:none;">
                            ✅ {{rubric_activate}}
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="evalia-rubric-status" class="mb-3"></div>
                    <div id="evalia-rubric-loading" style="display:none;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>{{rubric_generating}}</span>
                        </div>
                    </div>
                    <div id="evalia-rubric-items-container">
                        {{! Rubric items rendered dynamically by AMD }}
                    </div>
                </div>
            </div>
        </div>

        {{! ── Tab 2: Banco de Preguntas ─────────────────────────────── }}
        <div class="tab-pane fade" id="tab-questions" role="tabpanel">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">{{tab_questions}}</h5>
                    <button id="evalia-btn-generate-questions" class="btn btn-primary">
                        ✨ {{questions_generate}}
                    </button>
                </div>
                <div class="card-body">
                    {{! Filters row }}
                    <div class="row g-2 mb-3" id="evalia-questions-filters">
                        <div class="col-md-4">
                            <select id="evalia-filter-topic" class="form-select form-select-sm">
                                <option value="">{{filter_all_topics}}</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="evalia-filter-difficulty" class="form-select form-select-sm">
                                <option value="">{{filter_all_difficulties}}</option>
                                <option value="basic">{{difficulty_basic}}</option>
                                <option value="medium">{{difficulty_medium}}</option>
                                <option value="advanced">{{difficulty_advanced}}</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="evalia-filter-status" class="form-select form-select-sm">
                                <option value="">{{filter_all_statuses}}</option>
                                <option value="draft">{{questions_status_draft}}</option>
                                <option value="approved">{{questions_status_approved}}</option>
                                <option value="rejected">{{questions_status_rejected}}</option>
                            </select>
                        </div>
                    </div>
                    <div id="evalia-questions-loading" style="display:none;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>{{questions_loading}}</span>
                        </div>
                    </div>
                    <div id="evalia-questions-table-container">
                        {{! Table rendered dynamically by AMD }}
                    </div>
                </div>
            </div>
        </div>

        {{! ── Tab 3: Exámenes ────────────────────────────────────────── }}
        <div class="tab-pane fade" id="tab-exams" role="tabpanel">
            <div class="row">
                {{! Left: exam creation form }}
                <div class="col-md-5">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">📋 {{exam_create}}</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">{{exam_name}}</label>
                                <input type="text" id="evalia-exam-name" class="form-control"
                                       placeholder="{{exam_name_placeholder}}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{exam_instructions}}</label>
                                <textarea id="evalia-exam-instructions" class="form-control" rows="2"
                                          placeholder="{{exam_instructions_placeholder}}"></textarea>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <label class="form-label form-label-sm">{{exam_basic_count}}</label>
                                    <input type="number" id="evalia-exam-basic" class="form-control form-control-sm"
                                           value="{{exam_default_basic}}" min="0" max="20">
                                </div>
                                <div class="col-4">
                                    <label class="form-label form-label-sm">{{exam_medium_count}}</label>
                                    <input type="number" id="evalia-exam-medium" class="form-control form-control-sm"
                                           value="{{exam_default_medium}}" min="0" max="20">
                                </div>
                                <div class="col-4">
                                    <label class="form-label form-label-sm">{{exam_advanced_count}}</label>
                                    <input type="number" id="evalia-exam-advanced" class="form-control form-control-sm"
                                           value="{{exam_default_advanced}}" min="0" max="20">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{exam_time_limit}}</label>
                                <input type="number" id="evalia-exam-timelimit" class="form-control"
                                       value="{{exam_default_time_limit}}" min="0" max="300">
                            </div>
                            {{! Ventana de rendición (colapsable) }}
                            <div class="mb-3 border rounded p-2" style="background:#f8f9fa;">
                                <div class="d-flex align-items-center"
                                     id="evalia-exam-window-toggle" style="cursor:pointer;">
                                    <span class="fw-semibold small">📅 {{exam_window_title}}</span>
                                    <span class="text-muted small ms-2">{{label_optional}}</span>
                                    <span id="evalia-exam-window-arrow" class="ms-auto small text-secondary">▶</span>
                                </div>
                                <div id="evalia-exam-window-panel" style="display:none;" class="mt-2">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label form-label-sm mb-1">{{exam_window_open_label}}</label>
                                            <input type="datetime-local" id="evalia-exam-timeopen"
                                                   class="form-control form-control-sm">
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label form-label-sm mb-1">{{exam_window_close_label}}</label>
                                            <input type="datetime-local" id="evalia-exam-timeclose"
                                                   class="form-control form-control-sm">
                                        </div>
                                    </div>
                                    <p class="text-muted small mt-1 mb-0">
                                        {{exam_window_hint}}
                                    </p>
                                </div>
                            </div>
                            <button id="evalia-btn-create-exam" class="btn btn-primary w-100">
                                {{exam_create}}
                            </button>
                        </div>
                    </div>
                </div>
                {{! Right: student exam list }}
                <div class="col-md-7">
                    <div class="alert alert-light border d-flex align-items-center gap-2 py-2 px-3 mb-2" style="font-size:.85rem;">
                        <span>🔗 {{student_link_label}}</span>
                        <code id="evalia-student-url" class="flex-grow-1 text-truncate" style="font-size:.82rem;">{{student_page_url}}</code>
                        <button class="btn btn-sm btn-outline-secondary py-0"
                                onclick="navigator.clipboard.writeText('{{student_page_url}}').then(function(){this.textContent='✅';setTimeout(function(){document.querySelector('#evalia-student-url').parentNode.querySelector('button').textContent='{{btn_copy}}';},1500)}.bind(this))">{{btn_copy}}</button>
                    </div>
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="mb-0">👥 {{label_students}}</h6>
                                <select id="evalia-exam-selector" class="form-select form-select-sm" style="max-width:220px;">
                                    <option value="">{{exam_selector_none}}</option>
                                    {{#exam_list}}
                                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                    {{/exam_list}}
                                </select>
                            </div>
                            <div class="d-flex gap-2 align-items-center" style="flex-shrink:0;">
                                <span id="evalia-grade-all-status" class="text-muted small"></span>
                                <button id="evalia-btn-publish-all" class="btn btn-success btn-sm" style="display:none;">
                                    ✅ {{btn_publish_grades}}
                                </button>
                                <button id="evalia-btn-grade-all" class="btn btn-warning btn-sm" style="display:none;">
                                    ⚡ {{btn_grade_all}}
                                </button>
                                <button id="evalia-btn-assign-exam" class="btn btn-success btn-sm" style="display:none;">
                                    📤 {{exam_assign_all}}
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div id="evalia-exams-loading" style="display:none;" class="p-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span>{{exam_assigning}}</span>
                                </div>
                            </div>
                            <div id="evalia-student-exams-container">
                                <p class="text-muted text-center p-4">
                                    {{exam_none_created}}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {{! ── Panel de estadísticas ── }}
            <div id="evalia-stats-section" class="mt-4" style="display:none;">
                <div class="card border-info">
                    <div class="card-header d-flex justify-content-between align-items-center bg-info bg-opacity-10">
                        <h6 class="mb-0">📊 {{stats_title}}</h6>
                        <button id="evalia-btn-refresh-stats" class="btn btn-outline-info btn-sm">🔄</button>
                    </div>
                    <div class="card-body">
                        {{! Summary row }}
                        <div class="row g-3 mb-3" id="evalia-stats-summary">
                        </div>
                        {{! Score distribution + top failed side by side }}
                        <div class="row g-3">
                            <div class="col-md-5">
                                <h6 class="text-muted small mb-2">{{stats_distribution_title}}</h6>
                                <div id="evalia-stats-bands"></div>
                            </div>
                            <div class="col-md-7">
                                <h6 class="text-muted small mb-2">{{stats_failed_title}}</h6>
                                <div id="evalia-stats-failed"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {{! ── Prompt de feedback personalizable ── }}
            <div id="evalia-feedback-prompt-section" class="mt-4" style="display:none;">
                <div class="card border-secondary">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h6 class="mb-0">🤖 {{feedback_prompt_title}}</h6>
                        <button id="evalia-btn-reset-prompt" class="btn btn-outline-secondary btn-sm">
                            ↺ {{btn_reset_prompt}}
                        </button>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">
                            {{feedback_prompt_desc}}
                        </p>
                        <textarea id="evalia-feedback-prompt-textarea" class="form-control font-monospace"
                                  rows="10" style="font-size:0.82rem;"></textarea>
                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <span id="evalia-prompt-save-status" class="text-muted small align-self-center"></span>
                            <button id="evalia-btn-save-prompt" class="btn btn-primary btn-sm">
                                💾 {{btn_save_prompt}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! ── Tab 4: Legajos ─────────────────────────────────────────── }}
        <div class="tab-pane fade" id="tab-portfolio" role="tabpanel">
            <div class="row g-3">

                {{! ── Left: student list ─────────────────────────── }}
                <div class="col-md-5">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">👥 {{portfolio_students}}</h6>
                            <div class="d-flex gap-2">
                                <a href="{{wwwroot}}/local/evalia/export_portfolio.php?courseid={{courseid}}"
                                   class="btn btn-outline-success btn-sm" title="{{btn_download_csv_title}}">
                                    📥 {{portfolio_export_csv}}
                                </a>
                                <button id="evalia-btn-reload-portfolio"
                                        class="btn btn-outline-secondary btn-sm" title="{{btn_reload_title}}">
                                    🔄
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div id="evalia-portfolio-loading" style="display:none;" class="p-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span>{{portfolio_loading}}</span>
                                </div>
                            </div>
                            <div id="evalia-portfolio-list-container">
                                {{! Rendered by AMD }}
                            </div>
                        </div>
                    </div>
                </div>

                {{! ── Right: student detail ───────────────────────── }}
                <div class="col-md-7">
                    <div style="position:relative; min-height:400px; height:100%;">
                    <div id="evalia-portfolio-detail-placeholder"
                         class="card border-dashed text-center text-muted d-flex align-items-center justify-content-center"
                         style="position:absolute; inset:0;">
                        <div>
                            <div style="font-size: 2.5rem;">👈</div>
                            <p class="mt-2 mb-0">{{portfolio_select_student}}</p>
                        </div>
                    </div>
                    <div id="evalia-portfolio-detail-panel" style="display:none; position:absolute; inset:0; overflow-y:auto;">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0" id="evalia-portfolio-student-name">—</h6>
                                <div id="evalia-portfolio-student-stats" class="d-flex align-items-center gap-3 text-muted small"></div>
                            </div>
                            <div class="card-body">
                                {{! Inner mini-tabs: Exam History | Observations (manual JS toggle, no Bootstrap pills) }}
                                <ul class="nav nav-pills nav-fill mb-3">
                                    <li class="nav-item">
                                        <button class="nav-link active" id="pdt-exams-btn" type="button">
                                            📝 {{portfolio_exam_history}}
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link" id="pdt-notes-btn" type="button">
                                            💬 {{portfolio_observations}}
                                        </button>
                                    </li>
                                </ul>
                                <div>
                                    <div id="pdt-exams">
                                        <div id="evalia-portfolio-exams-container">
                                            <p class="text-muted text-center py-3">{{portfolio_no_exams}}</p>
                                        </div>
                                    </div>
                                    <div id="pdt-notes" style="display:none;">
                                        <div id="evalia-portfolio-notes-container" class="mb-3"
                                             style="max-height: 220px; overflow-y: auto;">
                                            <p class="text-muted small">{{portfolio_note_empty}}</p>
                                        </div>
                                        <div class="input-group">
                                            <textarea id="evalia-portfolio-note-input"
                                                      class="form-control form-control-sm" rows="2"
                                                      placeholder="{{note_placeholder}}"></textarea>
                                            <button class="btn btn-primary btn-sm"
                                                    id="evalia-btn-add-note">
                                                {{btn_save_note}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>{{! end position:relative wrapper }}
                </div>

            </div>{{! end row }}
        </div>

    </div>{{! end tab-content }}

    {{! Toast notifications }}
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="evalia-toast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive">
            <div class="d-flex">
                <div class="toast-body" id="evalia-toast-body"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

</div>{{! end #evalia-teacher-panel }}

{{! ── Modal: Flujo de trabajo ─────────────────────────────────────────── }}
<div id="evalia-workflow-modal"
     style="display:none; position:fixed; top:60px; left:50%; transform:translateX(-50%);
            z-index:10500; width:700px; max-width:96vw; background:#fff;
            border-radius:12px; box-shadow:0 8px 40px rgba(0,0,0,0.22);
            border:1px solid #e2e8f0;">
    <div id="evalia-workflow-modal-header"
         style="cursor:move; background:linear-gradient(135deg,#6366f1,#8b5cf6);
                color:#fff; padding:14px 18px; border-radius:12px 12px 0 0;
                display:flex; justify-content:space-between; align-items:center;
                user-select:none;">
        <span style="font-weight:700; font-size:1rem;">🗺️ {{workflow_modal_title}}</span>
        <button id="evalia-workflow-modal-close"
                style="background:none; border:none; color:#fff; font-size:1.4rem;
                       line-height:1; cursor:pointer; padding:0 4px;"
                aria-label="{{btn_close}}">&times;</button>
    </div>
    <div style="padding:20px 22px 18px; overflow-y:auto; max-height:80vh;">

        {{! Step row helper — each step is a card with an arrow after }}
        <div style="display:flex; flex-direction:column; gap:0;">

            {{! Step 1 }}
            <div style="display:flex; align-items:stretch; gap:10px;">
                <div style="display:flex; flex-direction:column; align-items:center;">
                    <div style="width:36px; height:36px; border-radius:50%; background:#0891b2;
                                color:#fff; display:flex; align-items:center; justify-content:center;
                                font-weight:700; font-size:.95rem; flex-shrink:0;">1</div>
                    <div style="width:2px; background:#cbd5e1; flex:1; margin:4px 0;"></div>
                </div>
                <div style="flex:1; padding-bottom:14px;">
                    <div style="font-weight:700; color:#0891b2; font-size:.9rem;">📚 {{workflow_step1_title}}</div>
                    <div style="font-size:.82rem; color:#475569; margin-top:3px;">
                        {{{workflow_step1_desc}}}
                    </div>
                </div>
            </div>

            {{! Step 2 }}
            <div style="display:flex; align-items:stretch; gap:10px;">
