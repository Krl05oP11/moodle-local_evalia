{{!
    @template local_evalia/student_exams

    Students of an exam with their status, grade and the action for that status.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * students - list of {fullname, statusclass, statuslabel, hasscore, score, examurl, student_examid, isassigned, isstarted, issubmitted, isgraded, ispublished}

    Example context (json):
    {
        "students": [
            {
                "fullname": "Ana García",
                "statusclass": "bg-success",
                "statuslabel": "Graded",
                "hasscore": true,
                "score": "8.5",
                "examurl": "https://example.edu/local/evalia/student_exam.php?student_examid=4",
                "student_examid": 4,
                "isassigned": false,
                "isstarted": false,
                "issubmitted": false,
                "isgraded": true,
                "ispublished": false
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="table-responsive">
    <table class="table table-sm mb-0">
        <thead class="table-light">
            <tr>
                <th>{{#str}}table_student, local_evalia{{/str}}</th>
                <th>{{#str}}table_status, local_evalia{{/str}}</th>
                <th class="text-center">{{#str}}table_grade, local_evalia{{/str}}</th>
                <th class="text-center">{{#str}}table_action, local_evalia{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#students}}
            <tr>
                <td>{{fullname}}</td>
                <td><span class="badge {{statusclass}}">{{statuslabel}}</span></td>
                <td class="text-center">{{#hasscore}}<strong>{{score}}</strong>{{/hasscore}}{{^hasscore}}<span class="text-muted">—</span>{{/hasscore}}</td>
                <td class="text-center">
                    {{#isassigned}}
                    <a href="{{examurl}}" target="_blank" class="btn btn-sm btn-outline-secondary py-0"
                        title="{{#str}}exam_preview_link_title, local_evalia{{/str}}">{{#str}}link_view, local_evalia{{/str}}</a>
                    {{/isassigned}}
                    {{#isstarted}}
                    <a href="{{examurl}}" target="_blank" class="btn btn-sm btn-outline-primary py-0"
                        title="{{#str}}exam_watching_link_title, local_evalia{{/str}}">{{#str}}link_view, local_evalia{{/str}}</a>
                    {{/isstarted}}
                    {{#issubmitted}}
                    <a href="{{examurl}}" target="_blank" class="btn btn-sm btn-warning py-0"
                        title="{{#str}}exam_grade_link_title, local_evalia{{/str}}">{{#str}}link_grade, local_evalia{{/str}}</a>
                    {{/issubmitted}}
                    {{#isgraded}}
                    <a href="{{examurl}}" target="_blank" class="btn btn-sm btn-outline-success py-0 me-1"
                        title="{{#str}}exam_view_graded_title, local_evalia{{/str}}">{{#str}}link_view_star, local_evalia{{/str}}</a>
                    <button type="button" class="btn btn-sm btn-success py-0 evalia-btn-publish-single" data-student-examid="{{student_examid}}"
                        title="{{#str}}exam_publish_single_title, local_evalia{{/str}}">{{#str}}btn_publish_single, local_evalia{{/str}}</button>
                    {{/isgraded}}
                    {{#ispublished}}
                    <a href="{{examurl}}" target="_blank" class="text-success small"
                        title="{{#str}}exam_view_published_title, local_evalia{{/str}}">{{#str}}link_view_star, local_evalia{{/str}}</a>
                    {{/ispublished}}
                </td>
            </tr>
            {{/students}}
        </tbody>
    </table>
</div>
