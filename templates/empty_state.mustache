{{!
    @template local_evalia/empty_state

    Empty states of the teacher panel whose language strings contain markup.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * rubric - true for the course without a rubric
    * questions - true when no question matches the filters

    Example context (json):
    {
        "rubric": true,
        "questions": false
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
{{#rubric}}<p class="text-muted">{{#str}}rubric_empty_state, local_evalia{{/str}}</p>{{/rubric}}
{{#questions}}<p class="text-muted text-center py-4">{{#str}}questions_empty_filtered, local_evalia{{/str}}</p>{{/questions}}
