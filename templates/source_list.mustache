{{!
    @template local_evalia/source_list

    Indexed course sources as checkboxes (all checked) for the question generation filter.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * sources - list of {eid, id, icon, label}

    Example context (json):
    {
        "sources": [
            {
                "eid": "evalia-src-page_12",
                "id": "page:12",
                "icon": "📄",
                "label": "Unit 1 notes"
            }
        ]
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="d-flex flex-wrap gap-2">
    {{#sources}}
    <label class="d-flex align-items-center gap-1 small border rounded px-2 py-1 evalia-source-label" for="{{eid}}">
        <input type="checkbox" class="evalia-source-cb" id="{{eid}}" data-source-id="{{id}}" checked>
        <span aria-hidden="true">{{icon}}</span> {{label}}
    </label>
    {{/sources}}
</div>
