{{!
    @template local_evalia/rubric_status

    Status badge and name of the course rubric.

    Rendered from amd/src/evalia_teacher.js with core/templates; every value is escaped.

    Context variables required for this template:
    * active - true when the rubric is active, false while it is a draft
    * name - rubric name

    Example context (json):
    {
        "active": true,
        "name": "Course 2 rubric"
    }

    @copyright  2026 Schaller & Ponce <dev@schaller-ponce.com.ar>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<span class="badge {{#active}}bg-success{{/active}}{{^active}}bg-secondary{{/active}} me-2">
    {{#active}}{{#str}}rubric_status_active, local_evalia{{/str}}{{/active}}{{^active}}{{#str}}rubric_status_draft, local_evalia{{/str}}{{/active}}
</span>
<small class="text-muted">{{name}}</small>
